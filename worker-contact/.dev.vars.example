# Copie para ".dev.vars" (sem ".example") nesta mesma pasta.
# ".dev.vars" é lido só pelo "wrangler dev" e nunca vai para o Cloudflare nem
# para o GitHub — está no .gitignore do projeto.

# Chave da API do Resend (https://resend.com → API Keys).
# Para testar localmente sem enviar e-mail de verdade, deixe o valor abaixo:
# o Worker vai falhar no envio e devolver 502, que é justamente o caminho de
# erro que vale testar. Para um teste real, use uma chave de verdade.
RESEND_API_KEY=re_chave_de_teste

# Sobrescreve as vars do wrangler.toml durante o desenvolvimento local.
MAIL_FROM=site@pedrodetrindade.com
MAIL_TO=contact@pedrodetrindade.com
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
